{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "security find-generic-password*": "deny",
      "databricks bundle destroy*": "deny",
      "databricks bundle deploy*": "deny",
      "gh release create*": "deny",
      "git push --force*": "deny",
      "gh pr create*": "ask",
      "git worktree*": "allow",
      "gh pr merge*": "deny",
      "gh pr ready*": "deny",
      "git push -f*": "deny",
      "git restore*": "allow",
      "databricks*": "ask",
      "git commit*": "allow",
      "git status*": "allow",
      "git switch*": "allow",
      "git stash*": "allow",
      "git diff*": "allow",
      "git push*": "ask",
      "git show*": "allow",
      "npm test*": "allow",
      "git add*": "allow",
      "git log*": "allow",
      "npm run*": "allow",
      "npm ci*": "allow",
      "pytest*": "allow",
      "uv run*": "allow",
      "*": "ask",
      "databricks current-user me*": "allow",
      "databricks apps list*": "allow"
    }
  },
  "mcp": {
    "databricks": {
      "type": "remote",
      "url": "https://REPLACE-WITH-YOUR-WORKSPACE-HOST/ai-gateway/mcp-services/REPLACE.WITH.YOUR_MCP_SERVICE",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:DATABRICKS_TOKEN}"
      }
    }
  }
}
