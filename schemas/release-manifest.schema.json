{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/althrussell/databricks-agentic-engineering-rails/schemas/release-manifest.schema.json",
  "title": "release/release-manifest.json",
  "description": "Validates release/release-manifest.json, produced by `make docs` and by the release workflow. Enforced by scripts/validate-manifests.py in `make check`: against the real file when a build has run, and always against schemas/fixtures/, so the schema is exercised on a clean clone rather than sitting unenforced until release day. Its job is to make a PDF traceable to the commit and the toolchain that produced it.",
  "validates": "release/release-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_version", "built_on", "git", "toolchain", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "built_on": { "type": "string", "format": "date-time" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^([0-9a-f]{40}|unknown)$" },
        "branch": { "type": "string" },
        "dirty": {
          "type": "boolean",
          "description": "True when the working tree had uncommitted changes at build time. A dirty release artefact is not reproducible and the manifest says so rather than hiding it."
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pandoc", "typst"],
      "properties": {
        "pandoc": { "type": "string", "minLength": 1 },
        "typst": { "type": "string", "minLength": 1 },
        "os": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/].*\\.(pdf|md|zip|json)$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "pages": { "type": "integer", "minimum": 1 },
          "source": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
