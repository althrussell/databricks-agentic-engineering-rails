{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/althrussell/databricks-agentic-engineering-rails/schemas/template-version.schema.json",
  "title": "template-version.yml",
  "description": "Validates the repository-root template-version.yml. Enforced by scripts/validate-manifests.py in `make check`, and copied into every project generated by scripts/new-project.sh so a generated repository can always answer which version of the rails it was cut from, and against which tool versions those rails were actually exercised.",
  "validates": "template-version.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_name", "version", "released_on", "upstream", "verified_against"],
  "properties": {
    "schema_version": { "const": 1 },
    "template_name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "released_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "generated_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "verified_against": {
      "type": "object",
      "description": "Tool versions this release was actually exercised with. Floors, not requirements, and honest about what was never run: an absent key means untested, not unsupported.",
      "additionalProperties": false,
      "properties": {
        "databricks_cli": { "$ref": "#/$defs/ver" },
        "unity_gateway_cli": { "$ref": "#/$defs/ver" },
        "gh": { "$ref": "#/$defs/ver" },
        "node": { "$ref": "#/$defs/ver" },
        "python": { "$ref": "#/$defs/ver" },
        "uv": { "$ref": "#/$defs/ver" },
        "pandoc": { "$ref": "#/$defs/ver" },
        "typst": { "$ref": "#/$defs/ver" },
        "opentofu": { "$ref": "#/$defs/ver" },
        "terraform": { "$ref": "#/$defs/ver" },
        "container_runtime": { "$ref": "#/$defs/ver" },
        "os": { "$ref": "#/$defs/ver" }
      }
    },
    "breaking_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "change", "migration"],
        "properties": {
          "version": { "type": "string" },
          "change": { "type": "string", "minLength": 15 },
          "migration": { "type": "string", "minLength": 15 }
        }
      }
    }
  },
  "$defs": {
    "ver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "expected", "not-verified"] },
        "note": { "type": "string", "minLength": 10 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["expected", "not-verified"] } }, "required": ["status"] },
          "then": { "required": ["note"], "description": "Anything short of verified says what was and was not run." }
        }
      ]
    }
  }
}
