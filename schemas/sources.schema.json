{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/althrussell/databricks-agentic-engineering-rails/schemas/sources.schema.json",
  "title": "sources.yml",
  "description": "Validates the repository-root sources.yml. Enforced by scripts/validate-manifests.py, which runs in `make check`. The point of this schema is to make an unciteable source impossible to commit: no wildcards, no bare domains, no undated entries, no unpinned repositories.",
  "validates": "sources.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verified_on", "reverify_interval_days", "verification_method", "totals", "pages", "repositories", "excluded"],
  "properties": {
    "schema_version": { "const": 1 },
    "verified_on": { "$ref": "#/$defs/date" },
    "reverify_interval_days": { "type": "integer", "minimum": 1, "maximum": 365 },
    "verification_method": {
      "type": "string",
      "minLength": 60,
      "description": "How the status column was produced, in enough detail that a reader knows what a 200 does and does not prove."
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates_checked", "reachable_200", "not_reachable", "cited_pages"],
      "properties": {
        "candidates_checked": { "type": "integer", "minimum": 1 },
        "reachable_200": { "type": "integer", "minimum": 0 },
        "not_reachable": { "type": "integer", "minimum": 0 },
        "cited_pages": { "type": "integer", "minimum": 1 }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "area", "status", "verified_on"],
        "properties": {
          "url": { "$ref": "#/$defs/exact_url" },
          "area": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "status": { "const": 200, "description": "Only reachable pages are cited. Anything else belongs in `excluded` with a reason." },
          "verified_on": { "$ref": "#/$defs/date" },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/doc_id" },
            "description": "Document ids from release-readiness.yml. Cross-checked by the validator: a source that supports nothing is dead weight, and a source that supports an unknown document is a typo."
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "commit", "commit_date", "files_read", "verified_on"],
        "properties": {
          "url": { "$ref": "#/$defs/exact_url" },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Full SHA. A branch or tag name is not evidence: both move."
          },
          "commit_date": { "type": "string", "format": "date-time" },
          "files_read": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "verified_on": { "$ref": "#/$defs/date" },
          "supports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/doc_id" } }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "status", "reason"],
        "properties": {
          "pattern": { "type": "string", "minLength": 8 },
          "status": { "type": ["integer", "string"] },
          "reason": {
            "type": "string",
            "minLength": 30,
            "description": "Why this candidate is not cited. 'Not used' is not a reason; name what was wrong with it or what replaced it."
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "doc_id": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z-]*$" },
    "exact_url": {
      "type": "string",
      "pattern": "^https://[^*?\\s]+/[^*\\s]*$",
      "description": "An exact page or repository URL. The pattern rejects wildcards and bare hosts, because a source list that names a domain names an unbounded corpus."
    }
  }
}
